{
  "name": "dsh-g1-ssh",
  "version": "1.1.0",
  "private": true,
  "description": "Wireless or wired SSH bridge to a Unitree G1 robot: agent tools plus a first-run connection dialog and a G1 settings page.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "unitree",
    "g1",
    "ssh",
    "robot"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JACKCHENGFENG/dsh-g1-ssh.git"
  },
  "homepage": "https://github.com/JACKCHENGFENG/dsh-g1-ssh#readme",
  "bugs": {
    "url": "https://github.com/JACKCHENGFENG/dsh-g1-ssh/issues"
  }
}
